{
  "mcpServers": {
    "forecastfoundry": {
      "command": "forecastfoundry",
      "args": ["mcp"],
      "env": {
        "EXECUTION_ENABLED": "false"
      },
      "toolAllowlist": [
        "list_supported_domains",
        "scan_markets",
        "get_market_evidence",
        "explain_prediction",
        "run_backtest",
        "provider_health",
        "portfolio_status",
        "reconcile_orders",
        "pause_execution",
        "resume_execution"
      ]
    }
  }
}
