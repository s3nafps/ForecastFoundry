APP_ENV=production
DATABASE_URL=sqlite+aiosqlite:///./data/weatheredge.db
# Telegram alerts are disabled when unset; to enable, uncomment and fill both.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_USER_ID=
POLYMARKET_POLL_SECONDS=120
WEATHER_POLL_SECONDS=900
OBSERVATION_POLL_SECONDS=300
OBSERVATION_BLEND_HOURS=36
OBSERVATION_MIN_COUNT=6
AVIATION_WEATHER_API_URL=https://aviationweather.gov/api/data/metar
MIN_RULE_CONFIDENCE=90
MIN_ENSEMBLE_MEMBERS=25
MIN_USABLE_EDGE=0.10
MAX_SPREAD=0.04
MIN_LIQUIDITY_USD=100
ESTIMATED_FEE=0.00
SLIPPAGE_BUFFER=0.01
UNCERTAINTY_BUFFER=0.04
RULE_RISK_BUFFER=0.02
PAPER_STARTING_BALANCE=5.00
FORECAST_MODELS=gfs_seamless,ecmwf_ifs025,icon_seamless,gem_global
STATION_CONFIG_PATH=config/stations.yaml
MARKET_OVERRIDES_PATH=config/market_overrides.yaml
REAL_TRADING_ENABLED=false
EXECUTION_ENABLED=false
EXECUTION_CONFIRMATION=
CLOSED_ONLY=true
KEYSTORE_PATH=
MAX_TRADE_FRACTION=0.05
MAX_EXPOSURE_FRACTION=0.25
MAX_DAILY_LOSS_FRACTION=0.10
GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYMARKET_CHAIN_ID=137
POLYMARKET_FUNDER_ADDRESS=
HERMES_MCP_ENABLED=true
SCHEDULER_ENABLED=true
POLYMARKET_WEBSOCKET_ENABLED=false
LOG_LEVEL=INFO
